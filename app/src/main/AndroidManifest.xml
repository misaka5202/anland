<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 「窗口打开时显示设置通知」（anland5 设置），API 33+ 需运行时授权 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- 麦克风：宿主侧的 PulseAudio 以 com.anlandnext 的 uid 运行，
         sles SOURCE 模块要建 AudioRecord 必须由该包声明 RECORD_AUDIO，
         否则 pm grant 无效、录音被系统拒绝（SL_RESULT_RESOURCE_ERROR）。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <!-- RECORD_AUDIO is a foreground-only app-op: the framework silences the
         record path once com.anlandnext stops being foreground, which reaches
         the container as a silent microphone. AudioBridgeService holds the uid
         foreground without a window, so no Activity has to stay on screen. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false">

        <!-- Launcher entry: window list (Attached/Detached state) -->
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- wayland windows are hosted by com.anlandnext.awl.AwlWindowActivity,
             merged in from the libawl library module (same code third-party
             consumer apps run) -->

        <!-- 桌面快捷方式的入口：透明、无布局、启动容器软体后立即 finish。
             放在本包而不是启动器包里，是为了让快捷方式的目标与窗口宿主同包，
             点下去直接进入应用，不经过启动器的加载界面。 -->
        <activity
            android:name=".AppLaunchActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="" />

        <!-- 快捷方式的创建入口：由 anland-shell 显式 intent 调起，用宿主包名
             调用 ShortcutManager.requestPinShortcut，让图标归宿主所有。
             透明、无布局、请求后立刻 finish；不接触 root 或 daemon。 -->
        <activity
            android:name=".PinShortcutActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="" />

        <!-- Window behavior settings。anland.action.OPEN_SETTINGS 让额外按键栏的
             「设置」键能从 libawl 库模块里跨模块拉起（库不依赖 app 类）。 -->
        <activity android:name=".WlSettingsActivity" android:exported="true">
            <intent-filter>
                <action android:name="anland.action.OPEN_SETTINGS"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>

        <!-- 硬件键拦截（对齐 anland5 的 KeyInterceptor）：Fn/F1-F12、Back→ESC -->
        <service
            android:name=".KeyInterceptor"
            android:exported="true"
            android:label="Anland KeyInterceptor"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config"/>
        </service>

        <!-- client closed its own window → daemon notification finishes the Activity -->
        <receiver android:name=".WindowGoneReceiver" android:exported="true">
            <intent-filter>
                <action android:name="anland.WINDOW_GONE"/>
            </intent-filter>
        </receiver>

        <!-- Started by module/service.sh before PulseAudio: keeps the uid
             foreground so the sles source keeps receiving PCM while the screen
             is off or no anland window is visible. exported so the daemon can
             start it with am; it holds no privileged state. -->
        <service
            android:name=".AudioBridgeService"
            android:exported="true"
            android:label="Anland AudioBridge"/>
    </application>
</manifest>
